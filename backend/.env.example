APP_NAME="Todo App"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=your-railway-host
DB_PORT=5432
DB_DATABASE=your-railway-database
DB_USERNAME=your-railway-username
DB_PASSWORD=your-railway-password

CACHE_STORE=file
